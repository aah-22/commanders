# Copy to .env for local runs. Production values live in Coolify, never in git.
SEASON=2026
TEAM=WAS
DATABASE_URL=postgresql+psycopg://commanders:commanders@localhost:5432/commanders      # owner role: jobs + migrations
DATABASE_URL_RO=postgresql+psycopg://commanders_ro:commanders_ro@localhost:5432/commanders  # SELECT-only role: the API
CORS_ORIGINS=https://commanders.caabi.dev,http://localhost:4200
MLFLOW_TRACKING_URI=https://mlflow.caabi.dev        # http://<mlflow internal ip>:5000 on the Droplet
MLFLOW_EXPERIMENT=commanders
CF_ACCESS_CLIENT_ID=                                 # only when MLFLOW_TRACKING_URI goes through Cloudflare
CF_ACCESS_CLIENT_SECRET=
